# DocuSense AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# WARNING: Never commit actual API keys or secrets to version control.

# Server Port (Hugging Face Spaces defaults to 7860; Render injects PORT dynamically)
PORT=7860

# Path to Tesseract binary (leave empty on Linux/Docker where tesseract is in PATH)
# On Windows, set if Tesseract is not in default "C:\Program Files\Tesseract-OCR\tesseract.exe":
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Application directory for temporary file storage
# The application automatically falls back to system tempdir if read-only
UPLOAD_DIR=uploads

# Maximum allowed file upload size in bytes (default: 10 MB = 10485760)
MAX_UPLOAD_BYTES=10485760

# Optional Vision-Language Model (VLM) Adapter
# The base application uses local Tesseract OCR and deterministic rules with zero paid APIs.
# Set ENABLE_VLM=true only if you intend to evaluate an external vision-language model.
ENABLE_VLM=false
VLM_API_KEY=your_optional_vlm_api_key_here
VLM_ENDPOINT=https://api.openai.com/v1/chat/completions
VLM_MODEL=gpt-4o-mini
